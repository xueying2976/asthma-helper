          "stringUnit": {
            "state": "translated",
            "value": "Stop reading Apple Health"
          }
        }
      }
    },
    "health.access.detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止读取不会删除 Apple 健康中的数据。读取权限由 Apple 健康管理，可在其中查看 AeriDay 的访问设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping reads doesn't delete Apple Health data. Read permissions are managed in Apple Health, where you can review AeriDay's access."
          }
        }
      }
