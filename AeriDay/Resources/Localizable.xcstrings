    "storage.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open local records. Unlock your iPhone and retry. Existing data won't be reset."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法打开本地记录。请解锁 iPhone 后重试；现有数据不会被重置。"
          }
        }
      }
    },
    "storage.save_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't confirm this save. Please retry and check your records."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认本次保存，请重试并检查记录。"
          }
        }
      }
    },
    "storage.backup_warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records aren't included in device backups. Uninstalling, device loss, or switching phones may lose your records."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录不进入设备备份。卸载、丢失设备或换机可能丢失记录。"
          }
        }
      }
    },
    "storage.delete_all": {
      "localizations": {
