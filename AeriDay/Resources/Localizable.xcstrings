    "reminder.time": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒时间"
          }
        }
      }
