    "reminder.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your chosen local time. Notifications omit names and quantities. Delivery may be delayed and does not record medication use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你设定的本地时间提醒，通知不显示药名或数量。系统可能延迟投递，提醒不代表已经用药。"
          }
        }
      }
    },
    "reminder.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's time for your reminder. Open AeriDay to view."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你设置的提醒时间到了。打开 AeriDay 查看。"
          }
        }
      }
    },
    "reminder.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications aren't allowed. Enable them in Settings, or turn off the daily reminder to save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未允许通知。你可以在系统设置中开启，或关闭每日提醒后保存。"
          }
        }
      }
    },
    "reminder.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your entry was saved, but the reminder couldn't be scheduled. Save again to retry, or turn the reminder off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
