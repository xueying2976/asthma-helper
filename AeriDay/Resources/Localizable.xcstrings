      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all local records?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除全部本地记录？"
          }
        }
      }
    },
    "storage.delete_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes notes, medications, and supply history, and cancels reminders. Apple Health data is untouched. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除笔记、药物和余量历史，并取消提醒。不会删除 Apple 健康中的数据，此操作无法撤销。"
          }
        }
      }
    },
