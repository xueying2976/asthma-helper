    "common.phase1_disclosure": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health is read only when you connect it. Other Phase 1 services remain synthetic, and no medical assessment is produced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后仅以只读方式访问 Apple 健康。阶段 1 的其他服务仍为合成数据，且不会生成医学评估。"
          }
        }
      }
    },
    "common.synthetic_disclosure": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase 0 uses synthetic data only. No real health or environmental service is connected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阶段 0 仅使用合成数据，尚未连接真实健康或环境服务。"
