    "health.disclosure.read_only": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read only, processed on this iPhone, and never used to diagnose asthma or change prescriptions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅只读并在这台 iPhone 上处理，不用于诊断哮喘或调整处方。"
          }
        }
      }
    },
    "health.education.boundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wearable data is supporting context only. It is not used to diagnose asthma, predict attacks, or adjust prescriptions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "穿戴设备数据只提供辅助背景，不用于诊断哮喘、预测发作或调整处方。"
          }
        }
      }
    },
    "health.education.introduction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AeriDay can read the Apple Health data you choose to share so you can view recent body and activity information. Connecting is optional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AeriDay 可以读取你选择共享的 Apple 健康数据，帮助你查看近期身体与活动信息。连接是可选的。"
          }
        }
      }
    },
